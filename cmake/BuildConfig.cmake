set(ALERTS_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")
if(NOT ALERTS_CONFIG_FILE)
    set(ALERTS_CONFIG_FILE "${ALERTS_ROOT}/config/alerts.example.json" CACHE FILEPATH
        "External JSON configuration compiled into this firmware")
endif()
get_filename_component(ALERTS_CONFIG_FILE "${ALERTS_CONFIG_FILE}" ABSOLUTE)
file(READ "${ALERTS_CONFIG_FILE}" ALERTS_JSON)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ALERTS_CONFIG_FILE}")
string(JSON ALERTS_WIFI_SSID GET "${ALERTS_JSON}" wifi ssid)
string(JSON ALERTS_WIFI_PASSWORD GET "${ALERTS_JSON}" wifi password)
foreach(key IN ITEMS primary_url reserve_url timezone poll_seconds stale_seconds
                     timeout_seconds brightness demo ota_url)
    string(TOUPPER "${key}" upper)
    string(JSON "ALERTS_${upper}" GET "${ALERTS_JSON}" "${key}")
endforeach()
foreach(key IN ITEMS poll_seconds stale_seconds timeout_seconds brightness)
    string(JSON kind TYPE "${ALERTS_JSON}" "${key}")
    string(TOUPPER "${key}" upper)
    if(NOT kind STREQUAL "NUMBER" OR NOT "${ALERTS_${upper}}" MATCHES "^[0-9]+$")
        message(FATAL_ERROR "${key} must be an integer")
    endif()
endforeach()
string(JSON demo_kind TYPE "${ALERTS_JSON}" demo)
if(NOT demo_kind STREQUAL "BOOLEAN")
    message(FATAL_ERROR "demo must be a JSON boolean")
endif()
if(ALERTS_DEMO)
    set(ALERTS_DEMO 1)
else()
    set(ALERTS_DEMO 0)
endif()
string(LENGTH "${ALERTS_WIFI_SSID}" ssid_length)
string(LENGTH "${ALERTS_WIFI_PASSWORD}" password_length)
foreach(key IN ITEMS ALERTS_WIFI_SSID ALERTS_WIFI_PASSWORD ALERTS_PRIMARY_URL
                     ALERTS_RESERVE_URL ALERTS_TIMEZONE ALERTS_OTA_URL)
    string(REPLACE "\\" "\\\\" "${key}" "${${key}}")
    string(REPLACE "\"" "\\\"" "${key}" "${${key}}")
    string(REPLACE "\n" "\\n" "${key}" "${${key}}")
    string(REPLACE "\r" "\\r" "${key}" "${${key}}")
endforeach()
if(ssid_length GREATER 32 OR password_length GREATER 63)
    message(FATAL_ERROR "Wi-Fi credentials exceed ESP-IDF field limits")
endif()
if(ALERTS_POLL_SECONDS LESS 30 OR ALERTS_POLL_SECONDS GREATER 3600)
    message(FATAL_ERROR "poll_seconds must be between 30 and 3600")
endif()
math(EXPR minimum_stale "${ALERTS_POLL_SECONDS} * 2")
if(ALERTS_STALE_SECONDS LESS minimum_stale OR ALERTS_STALE_SECONDS GREATER 86400)
    message(FATAL_ERROR "stale_seconds must allow at least two polls and be <= 86400")
endif()
if(ALERTS_TIMEOUT_SECONDS LESS 1 OR ALERTS_TIMEOUT_SECONDS GREATER 30)
    message(FATAL_ERROR "timeout_seconds must be between 1 and 30")
endif()
if(ALERTS_BRIGHTNESS LESS 5 OR ALERTS_BRIGHTNESS GREATER 100)
    message(FATAL_ERROR "brightness must be between 5 and 100")
endif()
foreach(key IN ITEMS ALERTS_PRIMARY_URL ALERTS_RESERVE_URL)
    if(NOT "${${key}}" MATCHES "^https://")
        message(FATAL_ERROR "${key} must use HTTPS")
    endif()
endforeach()
if(ALERTS_OTA_URL AND NOT ALERTS_OTA_URL MATCHES "^https://")
    message(FATAL_ERROR "ota_url must use HTTPS when specified")
endif()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/config")
configure_file("${CMAKE_CURRENT_LIST_DIR}/config.hpp.in"
               "${CMAKE_BINARY_DIR}/config/alerts_config.hpp" @ONLY)
