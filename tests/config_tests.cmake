set(root "${CMAKE_CURRENT_LIST_DIR}/..")
file(READ "${root}/config/alerts.example.json" original)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/config-tests")
function(check_case name content expected)
    set(work "${CMAKE_CURRENT_BINARY_DIR}/config-tests/${name}")
    file(MAKE_DIRECTORY "${work}")
    set(path "${work}/input.json")
    file(WRITE "${path}" "${content}")
    execute_process(
        COMMAND "${CMAKE_COMMAND}" "-DALERTS_CONFIG_FILE=${path}" -P "${root}/tests/config_probe.cmake"
        WORKING_DIRECTORY "${work}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(expected AND NOT result EQUAL 0)
        message(FATAL_ERROR "${name}: valid configuration rejected: ${errors}")
    elseif(NOT expected AND result EQUAL 0)
        message(FATAL_ERROR "${name}: invalid configuration accepted")
    endif()
endfunction()
check_case(valid "${original}" TRUE)
string(JSON fast SET "${original}" poll_seconds 1)
check_case(fast_poll "${fast}" FALSE)
string(JSON short_stale SET "${original}" stale_seconds 30)
check_case(short_stale "${short_stale}" FALSE)
string(JSON insecure SET "${original}" primary_url "\"http://example.invalid\"")
check_case(insecure "${insecure}" FALSE)
string(JSON string_number SET "${original}" poll_seconds "\"60\"")
check_case(string_number "${string_number}" FALSE)
string(JSON string_bool SET "${original}" demo "\"false\"")
check_case(string_bool "${string_bool}" FALSE)
string(REPEAT "s" 32 maximum_ssid)
string(JSON maximum SET "${original}" wifi ssid "\"${maximum_ssid}\"")
check_case(maximum_ssid "${maximum}" TRUE)
string(JSON oversized SET "${original}" wifi ssid "\"${maximum_ssid}s\"")
check_case(oversized_ssid "${oversized}" FALSE)
message(STATUS "PASS build-time config: valid, rate bounds, freshness, HTTPS and scalar types")
